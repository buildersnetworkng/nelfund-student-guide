# Copy this file to .env and fill in values for local development.
# Never commit a real .env file — it is already excluded in .gitignore.

# --- GitHub Pages / base path ---
VITE_BASE_PATH=/

# --- Privacy-safe analytics (server-side only; never use VITE_ for secrets) ---
# Upstash Redis REST (recommended for production multi-instance persistence)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin dashboard key for /admin (required in production when Redis is set)
ANALYTICS_ADMIN_KEY=

# --- NELFUND AI agent (server-side only; never use VITE_ for secrets) ---
# Prefer one provider. Agent is AI-first when any key is set; offline playbook is fallback.
# xAI (recommended for this project)
XAI_API_KEY=
XAI_MODEL=grok-3-mini
# XAI_BASE_URL=https://api.x.ai/v1

# Or OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Or any OpenAI-compatible gateway
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
