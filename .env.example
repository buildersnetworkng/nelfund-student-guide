# Copy this file to .env and fill in values for local development.
# Never commit a real .env file — it is already excluded in .gitignore.

# --- GitHub Pages / base path ---
VITE_BASE_PATH=/

# --- Privacy-safe analytics (server-side only; never use VITE_ for secrets) ---
# Upstash Redis REST (recommended for production multi-instance persistence)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin dashboard key for /admin (required in production when Redis is set)
ANALYTICS_ADMIN_KEY=
